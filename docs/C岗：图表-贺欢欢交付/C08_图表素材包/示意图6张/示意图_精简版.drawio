ontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="130" width="210" height="125" as="geometry"/></mxCell><mxCell id="s818e8211" value="MySQL 8 uev_charge&#10;ads 7 / insight 5&#10;sys 3 / v_* 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#22c55e;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="210" height="125" as="geometry"/></mxCell><mxCell id="sf920aab1" value="↑ 缓存读写：命中直接返回，未命中查库回填&#10;TTL 内不重复打库，数据更新即失效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1f1f;strokeColor=#ff6b35;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="390" y="292" width="420" height="64" as="geometry"/></mxCell><mxCell id="eb99803ee" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s3981bf32" target="sb8f558b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eb0df2647" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="sb8f558b7" target="s1a116dcc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e90b07860" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s1a116dcc" target="sb69f6833"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5388fa8e" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="sb69f6833" target="s818e8211"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t0e9d8f5a" value="接口调用关系与缓存分层" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=18;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1180" height="40" as="geometry"/></mxCell><mxCell id="t8e68efc9" value="一层只做一件事：校验 → 编排 → 取数；缓存挂在 Service 上" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1180" height="40" as="geometry"/></mxCell><mxCell id="t92eaeb20" value="分层依据：Controller 只管参数与路由，Service 管编排 / 缓存 / 降级，Mapper 只管取数；换库只改 Mapper。" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="396" width="1180" height="40" as="geometry"/></mxCell><mxCell id="td02a4be6" value="三条工程化指标：参数化查询防 SQL 注入 ｜ @Transactional 保证批量写原子性 ｜ 连接池 + 重试 + 异常降级不抛 500。" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#ff6b35;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="1180" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>