ometry"/></mxCell><mxCell id="e622fd14b" value="put" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s9ea747d9" target="s03ddac0b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ebec3335d" value="take" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s03ddac0b" target="scfbe6c50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eb2ff6779" value="LOCATION" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="scfbe6c50" target="s7eb43675"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t5c1f8de2" value="Flume 采集拓扑（12 通道）" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=18;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1180" height="40" as="geometry"/></mxCell><mxCell id="t2651de84" value="12 个 CSV → 12 条独立通道 → 12 个 HDFS 子目录 → 12 张 Hive 外部表" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1180" height="40" as="geometry"/></mxCell><mxCell id="t2f9044cd" value="① 为什么是 12 条通道：12 个 CSV 结构完全不同（6 张 276 列宽表 + 2 张 275×275 矩阵 + 维表 / POI / 2 张气象）。" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1180" height="40" as="geometry"/></mxCell><mxCell id="t5b76d038" value="② 一条通道只对应一张 ODS 表：可按表建表、按表增量、按表回溯；混在一个目录做不到。" style="text;h