1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="316" width="360" height="76" as="geometry"/></mxCell><mxCell id="s50022784" value="② 指标名（12px · 灰 #8fa8c8）&#10;③ 数值（24px 加粗 · 白）&#10;④ 单位 / 口径（9px · 主色）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="440" y="316" width="400" height="76" as="geometry"/></mxCell><mxCell id="sddb1d0f6" value="⑤ 空值统一显示 “--”&#10;⑥ 超 1 亿自动换算「亿」&#10;⑦ 环比暂不做（数据无对比期）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="860" y="316" width="330" height="76" as="geometry"/></mxCell><mxCell id="s8c2a4e50" value="数据源：ads_dashboard_kpi（dt, station_count, pile_count, avg_occupancy,&#10;total_volume, avg_duration_per_pile, imbalance_zones,&#10;persistent_imbalance_zones, compute_time）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3244;strokeColor=#00d4ff;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="442" width="560" height="56" as="geometry"/></mxCell><mxCell id="s746ad0d0" value="刷新策略：页面加载 1 次 + 每 60s 轮询；切筛选条件立即重取&#10;数值来源不可写死，必须由 loadKpi() 从接口灌入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3244;strokeColor=#22c55e;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="442" width="540" height="56" as="geometry"/></mxCell><mxCell id="raffc0a98" value="" style="rounded=1;fillColor=#0e2440;strokeColor=#2f5b86;opacity=50;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1160" height="150" as="geometry"/></mxCell><mxCell id="t85e42d04" value="C06  首页 KPI 指标卡（5 张 · 等宽一排 · 一屏扫读）" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=18;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1180" height="40" as="geometry"/></mxCell><mxCell id="t85728003" value="规则：数值最大、标题次之、单位最小；口径必须写在卡片底部，缺口径的卡片不算交付" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1180" height="40" as="geometry"/></mxCell><mxCell id="te6ecf675" value="覆盖分区数" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="58" y="139" width="1162" height="40" as="geometry"/></mxCell><mxCell id="t6673d371" value="275" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=22;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="181" width="1122" height="40" as="geometry"/></mxCell><mxCell id="t7644c0ff" value="个交通分区" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#00d4ff;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="58" y="221" width="1162" height="40" as="geometry"/></mxCell><mxCell id="t33831c3e" value="充电桩数" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="294" y="139" width="926" height="40" as="geometry"/></mxCell><mxCell id="t7e558ff2" value="23,441" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=22;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="334" y="181" width="886" height="40" as="geometry"/></mxCell><mxCell id="t941028f4" value="个" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#00d4ff;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="294" y="221" width="926" height="40" as="geometry"/></mxCell><mxCell id="tba943923" value="平均占用率" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="530" y="139" width="690" height="40" as="geometry"/></mxCell><mxCell id="t4041c959" value="27.1%" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=22;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="181" width="650" height="40" as="geometry"/></mxCell><mxCell id="t2fa0c4cb" value="全时段均值" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#ff6b35;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="530" y="221" width="690" height="40" as="geometry"/></mxCell><mxCell id="t8ed817d2" value="总充电量" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="766" y="139" width="454" height="40" as="geometry"/></mxCell><mxCell id="t1688061f" value="3.12" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=22;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="806" y="181" width="414" height="40" as="geometry"/></mxCell><mxCell id="t8ac4d72c" value="亿 kWh" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#22c55e;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="766" y="221" width="454" height="40" as="geometry"/></mxCell><mxCell id="t03e0764b" value="持续紧张分区" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1002" y="139" width="218" height="40" as="geometry"/></mxCell><mxCell id="t7b7b38ed" value="51" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=22;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1042" y="181" width="178" height="40" as="geometry"/></mxCell><mxCell id="t44d3106c" value="失衡时段占一半以上" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#ff6b35;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1002" y="221" width="218" height="40" as="geometry"/></mxCell><mxCell id="t6f8d89e0" value="卡片内部结构（自外向内 3 层）" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="1160" height="40" as="geometry"/></mxCell><mxCell id="t97bb7494" value="※ 五张卡等宽等高，间距 22px；1920 宽屏下整排占 ~1200px，预留左右留白，避免贴边" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#ff6b35;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="1160" height="40" as="geometry"/></mxCell><mxCell id="tedb64650" value="※ 平均占用率与持续紧张分区数是「判断性指标」，配色用橙色；数量类用青色，避免全部同色削弱重点" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="1160" height="40" as="geometry"/></mxCell><mxCell id="ta0bef393" value="※ 持续紧张分区 = 失衡时段占全部时段 ≥50%（51 个）；P3 供需图 TOP15 取的是失衡强度最高的 15 个，两者互补：一个讲长期反复，一个讲瞬时最紧" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#00d4ff;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="1160" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>