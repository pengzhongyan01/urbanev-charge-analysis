<mxfile host="app.diagrams.net" modified="2026-11-24T00:00:00.000Z" agent="doubao" version="24.7.5" type="device"><diagram id="p011fed380" name="C03 前端分层架构与职责边界"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sd2d3ce7c" value="表现层  index.html + css&#10;6 个大屏页面容器 · CSS 变量主题（#0b1a2f / #00d4ff）&#10;统一卡片、栅格、字号阶梯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#00d4ff;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="104" width="520" height="96" as="geometry"/></mxCell><mxCell id="s3981ccae" value="控制层  js/app.js&#10;getFilters() → bindEvents() → loadAll()&#10;loadKpi / loadHeatmap / loadHourly / loadImbalance&#10;loadPriceElasticity / loadForecast / loadSuggestion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#22c55e;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="234" width="520" height="96" as="geometry"/></mxCell><mxCell id="s8836b360" value="封装层  js/common.js&#10;api.get(path, params, {timeout:30s, retry:2})&#10;统一解析 res.code / res.data · 5 分钟 sessionStorage 缓存&#10;失败降级：读 assets/sample 兜底，保证答辩不白屏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#ffc107;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="364" width="520" height="96" as="geometry"/></mxCell><mxCell id="seb039380" value="接口层  REST /api/v1&#10;/kpi  /zones  /hourly  /imbalance&#10;/elasticity  /forecast  /suggestion  /dq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#ff6b35;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="494" width="520" height="96" as="geometry"/></mxCell><mxCell id="sebbf1056" value="数据层  MySQL&#10;ads_* 7 张 + insight_* 2 张 + dwd/dws 抽样 2 张&#10;只读账号，禁止前端直连" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#8fa8c8;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="624" width="520" height="96" as="geometry"/></mxCell><mxCell id="s9ced8ba2" value="① 主题统一：所有图表走 baseOption()&#10;背景 #0b1a2f、主色 #00d4ff、字体 12px" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="155" width="470" height="58" as="geometry"/></mxCell><mxCell id="sdf93d947" value="② 请求可观测：console 打印 url / 耗时 / 命中缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="225" width="470" height="52" as="geometry"/></mxCell><mxCell id="s8b0688c8" value="③ 降级优先：接口挂 → 本地样例 → 空态提示，绝不留白屏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="289" width="470" height="52" as="geometry"/></mxCell><mxCell id="sbcd501e4" value="开发期（D05 mock 契约）&#10;GET /api/v1/*.json 读静态文件&#10;→ C 岗 11/26 就能先出图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#123024;strokeColor=#22c55e;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="748" width="380" height="40" as="geometry"/></mxCell><mxCell id="s4ab3a7d1" value="联调期（D06 真实接口）&#10;切 baseURL 一个常量&#10;→ 11/28 换真数据，逻辑零改动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a12;strokeColor=#ff6b35;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="470" y="748" width="380" height="40" as="geometry"/></mxCell><mxCell id="s648d4246" value="验收期&#10;RUNBOOK + 冒烟测试&#10;→ 一键起 MySQL / 前端" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#00d4ff;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="748" width="300" height="40" as="geometry"/></mxCell><mxCell id="r3da596a5" value="" style="rounded=1;fillColor=#0e2440;strokeColor=#8fa8c8;opacity=45;arcSize=6;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="520" height="300" as="geometry"/></mxCell><mxCell id="e00abbc8c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="sd2d3ce7c" target="s3981ccae"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6c4f6aad" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s3981ccae" target="s8836b360"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e0c08c5cd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s8836b360" target="seb039380"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ef406a0de" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="seb039380" target="sebbf1056"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t7909f13a" value="C03  前端框架分层架构（表现层 → 控制层 → 封装层 → 接口层 → 数据层）" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=18;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1180" height="40" as="geometry"/></mxCell><mxCell id="tcc11dc37" value="分层目的：换数据源只改封装层，换页面只改表现层，图表逻辑全部收敛在 app.js 的 load*() 函数里" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa8c8;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1180" height="40" as="geometry"/></mxCell><mxCell id="t4a8613d4" value="三条硬约束（答辩会被问）" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="138" width="540" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>