<mxfile host="app.diagrams.net" modified="2026-11-24T00:00:00.000Z" agent="doubao" version="24.7.5" type="device"><diagram id="pfa01a1ed0" name="C03 请求封装与降级流程"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sa6c297b0" value="① 用户操作&#10;切时间 / 分区 / 小时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#00d4ff;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="170" height="76" as="geometry"/></mxCell><mxCell id="s5366869b" value="② getFilters()&#10;组装查询参数对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#00d4ff;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="170" height="76" as="geometry"/></mxCell><mxCell id="sc39effc4" value="③ 参数校验&#10;起止时间 / 分区存在性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#ffc107;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="96" width="170" height="64" as="geometry"/></mxCell><mxCell id="s04532bf8" value="校验失败&#10;红字提示 + 不请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a12;strokeColor=#ff6b35;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="210" width="170" height="64" as="geometry"/></mxCell><mxCell id="sbe95c01b" value="④ 缓存检查&#10;key = hash(参数)，TTL 5min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#ffc107;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="150" width="190" height="76" as="geometry"/></mxCell><mxCell id="s2fbce9ab" value="⑤ api.get(url, params)&#10;timeout 30s / retry 2 次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#00d4ff;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="96" width="180" height="70" as="geometry"/></mxCell><mxCell id="sede78b16" value="⑥ res.code === 0 ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#22c55e;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="96" width="130" height="70" as="geometry"/></mxCell><mxCell id="s958a8616" value="成功：写 STATE + render*()&#10;图表重绘 / KPI 刷新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#123024;strokeColor=#22c55e;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="240" width="340" height="64" as="geometry"/></mxCell><mxCell id="s56165584" value="失败：读 assets/sample/*.json&#10;顶部提示「离线样例数据」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a12;strokeColor=#ff6b35;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="340" width="340" height="64" as="geometry"/></mxCell><mxCell id="sf9a50571" value="缓存命中：直接 render()&#10;省一次接口往返" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#ffc107;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="260" width="190" height="64" as="geometry"/></mxCell><mxCell id="sff8008b4" value="约定：所有 load*() 只负责「取数 + setOption」，不碰 DOM 结构&#10;异常一律在 api 层收敛，业务层不需要 try/catch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="640" height="64" as="geometry"/></mxCell><mxCell id="s75152993" value="为什么要缓存：演示视频里来回切筛选，5 分钟缓存能让翻页瞬时；&#10;答辩被问「为什么这么快」时这就是答案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="556" width="640" height="64" as="geometry"/></mxCell><mxCell id="s3ba13252" value="为什么要降级：机房断网 / 后端没起 ≠ 系统坏了&#10;有兜底数据，演示流程照样跑完" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="642" width="640" height="56" as="geometry"/></mxCell><mxCell id="e89ca2d27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="sa6c297b0" target="s5366869b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e78f5403b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s5366869b" target="sc39effc4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22a22b05" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s5366869b" target="s04532bf8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eeaf46a2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source=