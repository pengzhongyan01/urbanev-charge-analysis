<mxfile host="app.diagrams.net" modified="2026-11-24T00:00:00.000Z" agent="doubao" version="24.7.5" type="device"><diagram id="p5cd413a70" name="C02 深圳地图怎么画出来的 · 三层方案"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s417004a3" value="行政区 9 个&#10;罗湖 · 福田 · 南山&#10;宝安 · 龙岗 · 盐田&#10;龙华 · 坪山 · 光明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#8fa8c8;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="58" y="136" width="156" height="96" as="geometry"/></mxCell><mxCell id="s72ebda55" value="交通分区 275 个&#10;编号 102 / 104 / 1066 …&#10;按出租车轨迹聚类出来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#8fa8c8;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="228" y="136" width="160" height="96" as="geometry"/></mxCell><mxCell id="s1caccb1f" value="① 读深圳边界&#10;9 个区的轮廓文件&#10;（69KB）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="450" y="140" width="190" height="78" as="geometry"/></mxCell><mxCell id="s5291d017" value="② 存成一张底图&#10;只加载一次&#10;后面直接复用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="690" y="140" width="190" height="78" as="geometry"/></mxCell><mxCell id="s404d19bf" value="③ 底图当背景&#10;深色填充&#10;只负责显轮廓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="930" y="140" width="200" height="78" as="geometry"/></mxCell><mxCell id="sdbb9e786" value="④ 275 个点落上去&#10;按经纬度找位置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="930" y="272" width="200" height="74" as="geometry"/></mxCell><mxCell id="sde78a6b4" value="⑤ 按占用率上色&#10;&gt;70% 紧张 橙&#10;40~70% 正常 青 / &lt;40% 闲置 绿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#2f5b86;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="650" y="272" width="210" height="74" as="geometry"/></mxCell><mxCell id="se100d256" value="第 1 步  先把底图载进来&#10;页面打开时调一次，&#10;载过就跳过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#22c55e;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="446" width="340" height="78" as="geometry"/></mxCell><mxCell id="s7e40cfe0" value="第 2 步  底图 + 点 两个图层&#10;点放上层，&#10;鼠标能看每个点的数值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#22c55e;fontColor=#e6f1ff;fontSize=10;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="460" y="446" width="340" height="78" as="geometry"/></mxCell><mxCell id="s88a9a96d" value="第 3 步  导出 1920×1080 静态图&#10;贴进 PPT 第 7 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12253f;strokeColor=#22c55e;fontColor=#e6f1ff;fontSize=9;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="860" y="446" width="300" height="78" as="geometry"/></mxCell><mxCell id="r738279ab" value="" style="rounded=1;fillColor=#2a1a12;strokeColor=#ff6b35;opacity=35;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="360" height="286" as="geometry"/></mxCell><mxCell id="rbf10e7fd" value="" style="rounded=1;fillColor=#0d3244;strokeColor=#00d4ff;opacity=30;arcSize=6;" vertex="1" parent="1"><mxGeometry x="430" y="86" width="760" height="286" as="geometry"/></mxCell><mxCell id="r4bd1516d" value="" style="rounded=1;fillColor=#0e2440;strokeColor=#2f5b86;opacity=50;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="396" width="1150" height="186" as="geometry"/></mxCell><mxCell id="e3f85aa14" value="加载" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s1caccb1f" target="s5291d017"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3457aea0" value="底图层" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s5291d017" target="s404d19bf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e231e24be" value="数据层" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="s404d19bf" target="sdbb9e786"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e667dff0a" value="上色" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00d4ff;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e6f1ff;fontSize=10;labelBackgroundColor=#0b1a2f;" edge="1" parent="1" source="sdbb9e786" target="sde78a6b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t21db4260" value="C02  深圳地图怎么画出来的（三层方案）" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=19;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1180" height="40" as="geometry"/></mxCell><mxCell id="tf48bdeee" value="① 问题：两套划分对不上" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#ff6b35;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="114" width="1160" height="40" as="geometry"/></mxCell><mxCell id="t760f5272" value="≠ 两者边界不重合：&#10;一个行政区里装着几十个交通分区，&#10;没有一一对应关系" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#ff6b35;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="1160" height="40" as="geometry"/></mxCell><mxCell id="te2cca5bb" value="→ 不按区分上色，&#10;数据按经纬度落到点上。" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e6f1ff;fontSize=9;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="1160" height="40" as="geometry"/></mxCell><mxCell id="t07c748af" value="② 方案：底图一层 + 点一层，叠成一张图" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#00d4ff;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="114" width="770" height="40" as="geometry"/></mxCell><mxCell id="t32b19d3b" value="③ 三步落地（照着做）" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#22c55e;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="424" width="1160" height="40" as="geometry"/></mxCell><mxCell id="t784655db" value="※ 底图放本地 assets/ 里，不写网络直链 —— 断网也能打开。" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#ff6b35;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="552" width="1160" height="40" as="geometry"/></mxCell><mxCell id="tf677442a" value="※ 底图加载失败也不白屏：退化成普通散点图，数值照常显示。" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#ff6b35;fontSize=10;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="578" width="1160" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>