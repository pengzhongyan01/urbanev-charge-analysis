{
  "info": {
    "name": "UrbanEV D岗 16 接口全量测试",
    "description": "运行顺序：先跑 02_login（会写入 {{token}} 变量），再跑其余接口。集合变量 baseUrl 默认 http://127.0.0.1:18080/api。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18080/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01_health 健康检查",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('业务码 code=200', () => pm.expect(j.code).to.eql(200));",
              "pm.test('含统一响应四字段', () => {",
              "  pm.expect(j).to.have.all.keys('code','message','data','timestamp');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02_login 登录获取令牌",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('业务码 code=200', () => pm.expect(j.code).to.eql(200));",
              "pm.test('含统一响应四字段', () => {",
              "  pm.expect(j).to.have.all.keys('code','message','data','timestamp');",
              "});",
              "pm.test('返回 token', () => pm.expect(j.data.token).to.be.a('string'));",
              "pm.collectionVariables.set('token', j.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"uev123456\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03_me 当前登录用户",
      "event": [
