    {
      "name": "09_imbalance 供需失衡 TOP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('业务码 code=200', () => pm.expect(j.code).to.eql(200));",
              "pm.test('含统一响应四字段', () => {",
              "  pm.expect(j).to.have.all.keys('code','message','data','timestamp');",
              "});",
              "pm.test('严格按失衡指数降序', () => {",
              "  const arr = j.data.top.map(x => x.imbalance);",
              "  for (let i = 1; i < arr.length; i++) pm.expect(arr[i]).to.be.at.most(arr[i-1]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/charts/imbalance?limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "charts",
            "imbalance"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
