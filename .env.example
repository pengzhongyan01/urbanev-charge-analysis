HDFS_NAMENODE_UI_PORT=9870
YARN_RM_UI_PORT=8088
HIVE_JDBC_PORT=10000
HIVE_UI_PORT=10002

# ---- 口令（★ 部署前改掉）----
MYSQL_ROOT_PASSWORD=uev123456
REDIS_PASSWORD=uev_redis_pass
MYSQL_DB=uev_charge

