<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml —— Spring Boot 后端 Maven 配置（骨架模板）

  维护人：D（杨珊珊）　|　骨架由 A（彭忠燕）提供，11/26 前按需修改

  说明：这是可直接编译运行的最小骨架。
       杨珊珊在此基础上补充 Controller / Service / Mapper / Entity。
       依赖版本已按 Java 17 + Spring Boot 3.2.5 对齐，不要随意升级大版本。

  ★ 版本历史
    v1.0  11/19  A  建立骨架
    v1.1  11/20  A  【修复致命 bug】原文件在 <?xml?> 声明之前写了 9 行 # 注释，
                   XML 规范不允许，导致 Maven 直接报
                   "Non-parseable POM ... only whitespace content allowed before start tag"
                   → 项目完全无法编译。已把注释改为合法 XML 注释并移到声明之后。
                   ★ D 同学 11/20 拉代码后请先跑一次 mvn clean package 验证。

  ★ 如果你要用 MyBatis-Plus（而不是 MyBatis），必须换成 SB3 专用坐标：
      <dependency>
          <groupId>com.baomidou</groupId>
          <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
          <version>3.5.5</version>
      </dependency>
    注意 artifactId 必须是 mybatis-plus-spring-boot3-starter（带 spring-boot3），
    用 mybatis-plus-boot-starter 在 Spring Boot 3 下会启动失败。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.uev</groupId>
    <artifactId>uev-charge-analysis</artifactId>
    <version>1.0.0</version>
    <name>uev-charge-analysis</name>
    <description>城市充电桩使用行为分析与充电需求预测系统 - 后端服务</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis.version>3.0.3</mybatis.version>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis（不用 JPA，因为 ADS 层表结构是宽表，SQL 控制更直接） -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis.version}</version>
        </dependency>

        <!-- Redis 缓存 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 通用缓存注解 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Apache Hive JDBC（只读查 ADS 表，可选） -->
        <dependency>
            <groupId>org.apache.hive</groupId>
            <artifactId>hive-jdbc</artifactId>
            <version>3.1.3</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 开发工具 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Lombok（简化实体类） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>uev-charge-analysis</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
